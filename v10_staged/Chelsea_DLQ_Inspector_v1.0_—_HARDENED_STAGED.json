      "parameters": {
        "jsCode": "'use strict';\nconst input=$input.first()?.json||{};const action=String(input.action||'inspect').toLowerCase();\nif(!['inspect','requeue','resolve'].includes(action))throw new Error('invalid_dlq_action');\nconst deadLetterId=String(input.deadLetterId||input.dead_letter_id||'').trim();if(action!=='inspect'&&!/^[0-9a-f-]{36}$/i.test(deadLetterId))throw new Error('dead_letter_id_required');\nconst limit=Math.max(1,Math.min(Number(input.limit||50),200));\nreturn [{json:{...input,action,deadLetterId,limit,operatorNote:String(input.operatorNote||'').slice(0,1000)}}];"
      }
    },
