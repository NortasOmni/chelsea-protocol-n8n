      "parameters": {
        "jsCode": "const vars=['CHELSEA_TELEGRAM_BOT_TOKEN','CHELSEA_OPENAI_API_KEY','CHELSEA_QDRANT_URL','CHELSEA_QDRANT_API_KEY','CHELSEA_KIE_API_KEY','CHELSEA_SUPABASE_URL','CHELSEA_SUPABASE_SERVICE_ROLE_KEY','CHELSEA_N8N_API_URL','CHELSEA_N8N_API_KEY'];const checks=vars.map(name=>({name,present:Boolean($env[name]),length:Number(String($env[name]||'').length)}));if(checks.some(x=>!x.present)) throw new Error(`Missing required environment variables: ${checks.filter(x=>!x.present).map(x=>x.name).join(', ')}`);return checks.map(x=>({json:x}));"
