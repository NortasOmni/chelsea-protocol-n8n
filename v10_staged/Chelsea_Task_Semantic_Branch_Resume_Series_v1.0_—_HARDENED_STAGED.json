        "jsCode": "'use strict';\nconst raw=$input.first()?.json||{};const envelope=raw.envelope&&typeof raw.envelope==='object'?raw.envelope:raw;let contexts={};try{contexts=typeof envelope.contextsJson==='string'?JSON.parse(envelope.contextsJson||'{}'):(envelope.contextsJson||{});}catch{contexts={};}\nconst route=Array.isArray(contexts['Code | Route Task Operation | TaskSemantic'])?(contexts['Code | Route Task Operation | TaskSemantic'][0]||{}):{};const trusted=JSON.parse(route._trustedJson||'{}');const rows=JSON.parse(route._rowsJson||'[]');const refs=JSON.parse(route._targetRefsJson||'{}');\nfunction terminal(fields){return [{json:{...envelope,resumeBranch:'terminal',terminalItems:[{...route,_mutationNeeded:false,_taskOutcomeJson:JSON.stringify(fields),taskHandled:fields.taskHandled!==false,taskOperation:fields.operation||'failed_review',taskRecordId:fields.recordId||'',taskErrorCode:String(fields.errorCode||route.taskErrorCode||'').slice(0,80),memoryWriteAllowed:false}]}}];}\ntry{const command=JSON.parse(envelope.semanticCommandJson||'{}');const recordId=refs[String(command.targetRef||'')];if(!recordId)throw Object.assign(new Error('Target must resolve through a local opaque reference'),{code:'target_not_exact'});const matches=rows.filter((row)=>row.recordId===recordId&&row.tenantId===trusted.tenantId&&row.ownerUserId===trusted.userId&&row.chatId===trusted.chatId);if(matches.length!==1)throw Object.assign(new Error('Target exact read is not unique'),{code:'target_not_exact'});const series=matches[0];if(series.recordType!=='series')throw Object.assign(new Error('Series resume target must be a series'),{code:'invalid_series_transition'});let resumeBranch='saga';if(series.status==='active')resumeBranch='active';else if(series.statusReason==='mutation_in_progress'&&series.pendingCommandJson)resumeBranch='interrupted';else if(!series.currentOccurrenceId)resumeBranch='direct';return [{json:{...envelope,resumeBranch,resumeSeriesRecordId:series.recordId}}];}catch(error){const retry=String(error.code||'')==='concurrency_conflict'||String(error.code||'')==='lease_conflict';return terminal(retry?{taskHandled:true,operation:'task_deferred_retry',text:'Задача сейчас обрабатывается планировщиком. Повторите команду чуть позже.',errorCode:String(error.code).slice(0,80)}:{taskHandled:true,operation:'failed_review',text:'Команда задач остановлена безопасно; изменения не применены.',errorCode:String(error.code||'contract_violation').slice(0,80)});}\n"
