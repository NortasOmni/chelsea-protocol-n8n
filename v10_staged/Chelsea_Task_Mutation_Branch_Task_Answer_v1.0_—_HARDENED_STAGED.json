        "jsCode": "'use strict';\nconst raw=$input.first()?.json||{};const envelope=raw.envelope&&typeof raw.envelope==='object'?raw.envelope:raw;let contexts={};try{contexts=typeof envelope.contextsJson==='string'?JSON.parse(envelope.contextsJson||'{}'):(envelope.contextsJson||{});}catch{contexts={};}\nconst route=Array.isArray(contexts['Code | Route Task Operation | TaskSemantic'])?(contexts['Code | Route Task Operation | TaskSemantic'][0]||{}):{};const trusted=JSON.parse(route._trustedJson||'{}');const rows=JSON.parse(route._rowsJson||'[]');\nfunction terminal(fields){return [{json:{...envelope,answerBranch:'terminal',terminalItems:[{...route,_mutationNeeded:false,_taskOutcomeJson:JSON.stringify(fields),taskHandled:fields.taskHandled!==false,taskOperation:fields.operation||'failed_review',taskRecordId:fields.recordId||'',taskErrorCode:String(fields.errorCode||route.taskErrorCode||'').slice(0,80),memoryWriteAllowed:false}]}}];}\ntry{const actionMap={done:'done',not_done:'not_done',snooze:'snooze',reschedule:'reschedule',cancel:'cancel',skip_occurrence:'skip_occurrence'};let answerAction=actionMap[route._callbackAction]||(/^(?:сделал|сделала|готово|выполнено)$/iu.test(String(route.messageText||'').trim())?'done':'');const matches=route._callbackToken?rows.filter((row)=>row.recordType==='task'&&row.correlationToken===route._callbackToken):rows.filter((row)=>row.recordType==='task'&&row.askedMessageId===String(route.replyToMessageId||''));if(matches.length!==1)throw Object.assign(new Error('Task answer must correlate to exactly one row'),{code:'correlation_mismatch'});const row=matches[0];if(route._callbackToken&&String(route.messageId||'')!==row.askedMessageId)throw Object.assign(new Error('Callback message does not match exact askedMessageId'),{code:'correlation_mismatch'});if(!route._callbackToken&&String(route.replyToMessageId||'')!==row.askedMessageId)throw Object.assign(new Error('Reply does not match exact askedMessageId'),{code:'correlation_mismatch'});let answerBranch='normal';if(row.status==='draft'&&answerAction==='cancel')answerBranch='cancel_draft';else if(row.status==='draft'&&row.draftKind==='mutation')answerBranch='mutation_draft';else if(row.status==='draft'&&row.draftKind==='create')answerBranch='create_draft_needs_details';else if(!answerAction||answerAction==='reschedule')answerBranch='answer_needs_details';return [{json:{...envelope,answerBranch,answerRecordId:row.recordId,answerAction}}];}catch(error){const retry=String(error.code||'')==='concurrency_conflict'||String(error.code||'')==='lease_conflict';return terminal(retry?{taskHandled:true,operation:'task_deferred_retry',text:'Задача сейчас обрабатывается планировщиком. Повторите команду чуть позже.',errorCode:String(error.code).slice(0,80)}:{taskHandled:true,operation:'failed_review',text:'Команда задач остановлена безопасно; изменения не применены.',errorCode:String(error.code||'contract_violation').slice(0,80)});}\n"
