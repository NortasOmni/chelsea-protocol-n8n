        "jsCode": "'use strict';const source=$('Code | Parse Privacy Telegram Command | PrivacyTelegram').first().json;const raw=$input.first()?.json||{};const body=raw.body??raw.data??raw;const r=Array.isArray(body)?body[0]:body;let text;if(!r?.found)text='Запрос не найден.';else{text=`Privacy-запрос ${r.requestId}\nОперация: ${r.operation}\nСтатус: ${r.status}`;const targets=r.targets&&typeof r.targets==='object'?r.targets:{};for(const [k,v] of Object.entries(targets))text+=`\n${k}: ${v.status}${v.error?` — ${String(v.error).slice(0,120)}`:''}`;}return [{json:{...source,privacyReplyText:text.slice(0,3900),privacyHandled:true}}];"
