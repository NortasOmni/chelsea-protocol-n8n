      "parameters": {
        "jsCode": "'use strict';\nconst x=$input.first()?.json||{};const clean=v=>String(v??'').normalize('NFKC').trim();\nconst raw=clean(x.messageText||x.text||x.message?.text||x.callbackQueryData||x.callback_query?.data);const lower=raw.toLowerCase();\nconst principalKey=clean(x.principalKey);const actor=clean(x.telegramActorId||x.telegramUserId||x.message?.from?.id);const chatId=clean(x.chatId||x.message?.chat?.id);\nlet kind='none',payload={},reply='';\nif(['/privacy','/privacy_help'].includes(lower)){kind='help'}\nelse if(lower==='/privacy_export'){kind='request';payload={operation:'export',requestId:`privacy_${principalKey.slice(-16)}_${Date.now()}`}}\nelse if(lower==='/privacy_delete'){kind='request';payload={operation:'delete_preview',requestId:`privacy_${principalKey.slice(-16)}_${Date.now()}`}}\nelse if(lower.startsWith('/privacy_delete_confirm ')){const parts=raw.split(/\\s+/);if(parts.length===3){kind='request';payload={operation:'delete_confirm',requestId:parts[1],confirmationToken:parts[2]}}else{kind='help'}}\nelse if(lower.startsWith('/privacy_download ')){const parts=raw.split(/\\s+/);kind=parts[1]?'delivery':'help';payload={requestId:parts[1]||''}}\nelse if(lower.startsWith('/privacy_status ')){const parts=raw.split(/\\s+/);kind=parts[1]?'status':'help';payload={requestId:parts[1]||''}}\nelse if(lower.startsWith('/consent ')){const parts=lower.split(/\\s+/);const aliases={memory:'memory_storage',analytics:'analytics',proactivity:'proactive_messages',files:'file_storage',privacy:'privacy_processing'};const ct=aliases[parts[1]]||parts[1];if(parts.length===3&&['grant','revoke'].includes(parts[2])){kind='consent';payload={consentType:ct,action:parts[2]}}else kind='help'}\nreturn [{json:{...x,privacyHandled:kind!=='none',privacyCommandKind:kind,privacyPayload:payload,principalKey,telegramActorId:actor,chatId,privacyRawCommand:raw}}];"
      }
