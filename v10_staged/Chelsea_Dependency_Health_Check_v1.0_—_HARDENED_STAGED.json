      "parameters": {
        "jsCode": "'use strict';const source=$('Code | Build Dependency Checks | DependencyHealth').item.json;const raw=$input.first()?.json||{};const body=raw.body??raw.data??raw;const rows=Array.isArray(body)?body:(Array.isArray(body?.data)?body.data:[]);const hit=rows.find(r=>String(r?.name||'')===source.dependencyName);return [{json:{dependencyName:source.dependencyName,configured:true,found:Boolean(hit),workflowId:String(hit?.id||''),active:hit?.active===true}}];"
