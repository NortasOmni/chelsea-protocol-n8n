        "jsCode": "'use strict';const source=$('Code | Validate Reliability Snapshot | Reliability').first().json;const raw=$input.first()?.json||{};const body=raw.body??raw.data??raw;const r=Array.isArray(body)?body[0]:body;if(!r||typeof r.shouldSend!=='boolean'||!/^[a-f0-9]{64}$/.test(String(r.fingerprint||'')))throw new Error('reliability_alert_claim_invalid');return [{json:{...source,shouldSend:r.shouldSend,alertFingerprint:r.fingerprint,alertCooldownSeconds:Number(r.cooldownSeconds||0)}}];"
