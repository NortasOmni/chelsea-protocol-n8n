      "parameters": {
        "jsCode": "'use strict';const raw=$input.first()?.json||{};const body=raw.body??raw.data??raw;const r=Array.isArray(body)?body[0]:body;if(!r||typeof r.alertRequired!=='boolean')throw new Error('reliability_snapshot_invalid');const text=`Chelsea reliability alert\nОшибки 24ч: ${r.openErrors}\nDLQ: ${r.openDeadLetters}\nPrivacy DLQ: ${r.privacyDeadLetters}\nЗависшие privacy: ${r.staleProcessingPrivacy}\nИстёкшие leases: ${r.expiredSchedulerLeases}`;return [{json:{...r,alertText:text,adminChatId:String($env.CHELSEA_ADMIN_TELEGRAM_CHAT_ID||'')}}];"
      }
