      "parameters": {
        "jsCode": "'use strict';\nconst cfg=$('Code | Build Smoke Test Config | SmokeTests').first().json;\nconst read=name=>{try{return $(name).first().json||{}}catch{return {missing:true}}};\nconst body=x=>x?.body??x?.data??x;\nconst sanitize=x=>JSON.parse(JSON.stringify(x,(k,v)=>/(token|key|secret|password|authorization)/i.test(k)?'[REDACTED]':v));\nconst telegram=body(read('Call | Telegram | Get Me | SmokeTests'));\nconst qdrant=body(read('Call | Qdrant | List Collections | SmokeTests'));\nconst supabase=body(read('Call | Supabase | Read Principal Schema | SmokeTests'));\nconst n8n=body(read('Call | n8n API | List Imported Workflows | SmokeTests'));\nconst workflows=Array.isArray(n8n)?n8n:(Array.isArray(n8n?.data)?n8n.data:[]);\nconst normalized=workflows.map(x=>({id:String(x?.id||''),name:String(x?.name||'')}));\nconst dependencies=cfg.expectedWorkflowNames.map(expectedName=>{\n const clean=s=>String(s||'').toLowerCase().replace(/\\bv\\d+(?:\\.\\d+)*\\b/g,'').trim();\n const match=normalized.find(x=>clean(x.name).includes(clean(expectedName)))||null;\n return {expectedName,found:Boolean(match),workflowId:match?.id||'',actualName:match?.name||''};\n});\nconst checks={\n telegram:Boolean(telegram?.ok===true),\n qdrant:Boolean(Array.isArray(qdrant?.result?.collections)||Array.isArray(qdrant?.collections)),\n supabase:Boolean(Array.isArray(supabase)),\n dependencies:dependencies.every(x=>x.found)\n};\nreturn [{json:{ok:Object.values(checks).every(Boolean),configured:{credentialChecks:cfg.credentialChecks},checks,dependencies,tests:sanitize({telegram,qdrant,supabase,n8nWorkflowCount:normalized.length}),smokeVersion:'chelsea_integration_smoke_v4',noWrite:true,checkedAt:new Date().toISOString()}}];"
      }
