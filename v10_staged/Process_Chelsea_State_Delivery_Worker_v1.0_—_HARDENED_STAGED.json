    {
      "parameters": {
        "jsCode": "'use strict';\nconst row=$input.first()?.json||{};\nconst chatId=String(row.telegram_chat_id||row.telegramChatId||row.delivery_address||row.deliveryAddress||'').trim();\nconst content=String(row.content_text||row.contentText||'').trim();\nreturn [{json:{...row,stateDelivery:row.stateDelivery||row,telegramRequestBody:{chat_id:chatId,text:content},stateDeliveryReady:Boolean(chatId&&content),stateDeliveryError:chatId&&content?'':'delivery_context_missing'}}];"
