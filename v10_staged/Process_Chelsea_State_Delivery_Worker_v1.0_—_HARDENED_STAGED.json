        "jsCode": "'use strict';\nconst source=$('Code | Build State Delivery Telegram Request | Delivery').item.json||{};\nconst response=$input.first()?.json||{};\nconst externalId=String(response.message_id||response.result?.message_id||'').trim();\nconst zone=String(source.timezone||'Asia/Novosibirsk');\nconst parts=new Intl.DateTimeFormat('en-CA',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());\nconst part=type=>parts.find(value=>value.type===type)?.value||'';\nconst sentOn=`${part('year')}-${part('month')}-${part('day')}`;\nreturn [{json:{...source,stateDeliverySendConfirmed:Boolean(externalId),stateDeliveryExternalMessageId:externalId,stateRpcBody:{p_delivery_id:source.delivery_id||source.deliveryId,p_lease_token:source.lease_token||source.leaseToken,p_expected_delivery_version:Number(source.delivery_version??source.deliveryVersion),p_confirmation_key:`delivery_confirm:${source.delivery_id||source.deliveryId}`,p_external_message_id:externalId,p_sent_at:new Date().toISOString(),p_sent_on:sentOn,p_evaluation_delay_days:null}}}];"
