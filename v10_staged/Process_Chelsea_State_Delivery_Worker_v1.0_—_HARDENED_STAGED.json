    {
      "parameters": {
        "jsCode": "'use strict';\nconst rows=$input.all().flatMap(item=>{const value=item.json?.body??item.json??{};return Array.isArray(value)?value:(Array.isArray(value.data)?value.data:[value]);});\nreturn rows.filter(row=>row&&row.delivery_id&&row.lease_token).map(row=>({json:{...row,stateDelivery:row}}));"
