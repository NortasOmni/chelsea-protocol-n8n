      "parameters": {
        "jsCode": "'use strict';const source=$('Code | Validate Consent Gate Request | ConsentGate').first().json;const raw=$input.first()?.json||{};const body=raw.body??raw.data??raw;const r=Array.isArray(body)?body[0]:body;if(!r||typeof r.granted!=='boolean')throw new Error('consent_gate_receipt_invalid');return [{json:{...source,consentGranted:r.granted===true,consentReceipt:r,consentBypass:false}}];"
