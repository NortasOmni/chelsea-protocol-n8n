      "parameters": {
        "jsCode": "'use strict';\nconst x=$input.first()?.json||{};const clean=v=>String(v??'').normalize('NFKC').trim();\nconst principalKey=clean(x.principalKey||x.ownerPrincipalKey);const telegramActorId=clean(x.telegramActorId||x.telegramUserId);\nconst consentType=clean(x.consentType);const required=x.consentRequired!==false;\nif(!required)return [{json:{...x,consentRequired:false,consentGranted:true,consentBypass:true}}];\nif(!/^tgactor_[a-f0-9]{64}$/.test(principalKey))throw new Error('consent_gate_principal_invalid');\nif(!/^\\d+$/.test(telegramActorId))throw new Error('consent_gate_actor_invalid');\nif(!['privacy_processing','memory_storage','proactive_messages','analytics','file_storage'].includes(consentType))throw new Error('consent_gate_type_invalid');\nreturn [{json:{...x,principalKey,telegramActorId,consentType,consentRequired:true,consentBypass:false}}];"
      }
    },
