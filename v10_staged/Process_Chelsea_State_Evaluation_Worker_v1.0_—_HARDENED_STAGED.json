    {
      "parameters": {
        "jsCode": "'use strict';\nconst source=$('Code | Build State Evaluation Complete RPC | Evaluation').item.json||{};\nconst incoming=$input.first()?.json||{};\nconst body=incoming.body&&typeof incoming.body==='object'?incoming.body:incoming;\nconst ok=body?.contractVersion==='chelsea_state_evaluation_complete_v1'&&String(body.evaluationId||'')===String(source.evaluation_id||source.evaluationId||'')&&body.status==='completed';\nreturn [{json:{...source,stateEvaluationResult:body,stateEvaluationCompleted:ok,stateEvaluationError:ok?'':String(body?.message||body?.error?.message||'evaluation_complete_failed')}}];"
      },
