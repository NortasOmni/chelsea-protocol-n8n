    {
      "parameters": {
        "jsCode": "'use strict';\nconst row=$input.first()?.json||{};\nconst zone=String(row.timezone||'Asia/Novosibirsk');\nconst parts=new Intl.DateTimeFormat('en-CA',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());\nconst part=type=>parts.find(value=>value.type===type)?.value||'';\nconst localDate=`${part('year')}-${part('month')}-${part('day')}`;\nconst scheduled=String(row.scheduled_on||row.scheduledOn||'');\nconst asOfDate=localDate>=scheduled?localDate:scheduled;\nreturn [{json:{...row,stateEvaluation:row.stateEvaluation||row,stateRpcBody:{p_evaluation_id:row.evaluation_id||row.evaluationId,p_lease_token:row.lease_token||row.leaseToken,p_expected_evaluation_version:Number(row.evaluation_version??row.evaluationVersion),p_completion_key:`evaluation_complete:${row.evaluation_id||row.evaluationId}:${asOfDate}`,p_as_of_date:asOfDate,p_helpfulness_rating:null,p_evaluation_note:null}}}];"
      },
