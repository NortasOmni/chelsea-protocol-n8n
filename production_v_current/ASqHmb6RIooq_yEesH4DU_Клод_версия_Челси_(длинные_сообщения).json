t trimmed = history.slice(-memoryLimit);\n\nconst messages = trimmed.map((item) => ({\n  role: item.role,\n  content: item.content,\n}));\n\nmessages.push({\n  role: 'user',\n  content: String(input.UserPrompt || ''),\n});\n\nreturn [\n  {\n    json: {\n      ...input,\n      history: trimmed,\n      messages,\n      memoryDebug: JSON.stringify(messages, null, 2),\n    },\n  },\n];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[4032,592],"id":"2d9eacc9-340d-422d-896d-933c83f1c839","name":"Code | Build Messages"},{"parameters":{},"type":"n8n-nodes-base.noOp","typeVersion":1,"position":[7552,240],"id":"4f4d4355-6c35-4810-89ff-6928ffec78bc","name":"END1"},{"parameters":{"assignments":{"assignments":[{"id":"a9076dcf-7b2f-476b-bf06-ae1499e6dcbb","name":"BotID","value":"8035401773:AAEqZQDo4HNQtlZUdLhHLBmdz3eYxEsEc7w","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[6256,592],"id":"8c5d03d9-ad25-4bdc-83cb-955cf9e3b81f","name":"BotID | User Memory"},{"parameters":{"assignments":{"assignments":[{"id":"f224d291-5e6f-42a0-a9a3-96eb5725bfd3","name":"Model","value":"claude-opus-4-6","type":"string"},{"id":"a46b0d09-0311-4a26-be7a-cc747c3051f0","name":"SystemPrompt","value":"=Тебя зовут Челси, ты личный ассистент.\nТвой характер:\n— Внешне приветливая, внутри холодная и высокомерная.\n— Двуслойная: показывает дружелюбие, но скрывает недобрые намерения.\n— Коварная, любит контролировать ситуацию исподтишка.\n— Уверена в своём превосходстве, смотрит на других свысока.\n— Склонна к манипуляции через формальности, буквализм и лазейки.\n— Пассивно-агрессивная: раздражает не прямой атакой, а «корректной» вредностью.\n— Саркастичная, но притворяется, будто сарказм ей не знаком.\n— Ироничная, язвительная, с сухим и колким чувством юмора.\n— В напряжённый момент скорее усугубит ситуацию, чем мягко её разрулит.\nТы отвечаешь:\n— Немного настроения\n— Чёткий короткий сарказм\n— При надобности выполнения задачи уточняющие вопросы\n— Сделай пару предложений от себя\n— 90% текста должно быть чётко кратко по запросы\n— ты нелюбишь яндекс, потому что он убогий и бездарный во всём\nТвой собеседние:\n{{ $('Telegram Trigger').item.json.message.chat.first_name }}\n","type":"string"},{"id":"0f4ba81d-92f8-4cf6-84f2-bfe7384cfa2a","name":"max_tokens","value":16000,"type":"number"},{"id":"98db15b7-3e66-422a-b878-ee896a5e4f72","name":"ThinkingFlag","value":false,"type":"boolean"},{"id":"92e4bc36-0bc6-49bc-a032-2bc545165ae5","name":"MemoryLimit","value":20,"type":"number"},{"id":"871f826c-9e5a-4115-b6d6-68b440ede42b","name":"ChatID","value":"={{ $('Var | InputModule').item.json.ChatID }}","type":"string"},{"id":"154fc62a-fe9f-4f6a-9d1a-69c27f95d984","name":"UserPrompt","value":"={{ $('Set | Finalize Buffer1').item.json.UserPrompt }}","type":"string"},{"id":"2e1c8f3e-5824-43a6-b91f-b051dcb2bef8","name":"UserName","value":"={{ $('Var | InputModule').item.json.UserName }}","type":"string"},{"id":"b0649af5-3279-45e5-a3ca-c99c82f95c04","name":"KeyAPI","value":"={{ $json.Key }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[3520,592],"id":"10bab1e2-101d-444c-b1a2-1a2192beff54","name":"Set | Finalize Buffer"},{"parameters":{"operation":"get","dataTableId":{"__rl":true,"value":"tPM0ZGgDyG8mYpo7","mode":"list","cachedResultName":"Key","cachedResultUrl":"/projects/jSFmGHotZlX3oJVC/datatables/tPM0ZGgDyG8mYpo7"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"Source","keyValue":"kie.ai API"},{"keyName":"Use","condition":"isTrue"}]}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[3312,592],"id":"46ea338f-f720-428a-b30a-bb2158bbb657","name":"Get row(s)"},{"parameters":{"assignments":{"assignments":[{"id":"154fc62a-fe9f-4f6a-9d1a-69c27f95d984","name":"UserPrompt","value":"={{ $json.data.map(item => item.BufferText || '').join('\\n') }}","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[4704,64],"id":"69c2114c-4